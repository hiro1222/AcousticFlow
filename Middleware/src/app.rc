// app.rc — 実行ファイルに埋め込む資源。
//
// ★アイコンの ID を 1 にしているのには理由がある。
//   Explorer やタスクバーが exe の「顔」に使うのは、**ID がいちばん小さいアイコン**
//   （名前順ではなく数値順）。ここを大きい値にすると、埋め込んだのに既定のまま出る。

#include <windows.h>

1 ICON "..\\assets\\icon.ico"

// 版の情報。プロパティ画面に出るほか、配ったあと「どの版か」を追える。
// ⚠ 名前（開発環境側）は仮称なので、ここには**製品名を書いていない**。
//   仮称を資源に焼くと、変えるときに実行ファイルまで巻き込む。
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041104b0"          // 日本語 / Unicode
        BEGIN
            VALUE "FileDescription", "AcousticFlow 開発環境"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "AfHost"
            VALUE "OriginalFilename","AfHost.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x411, 1200
    END
END
